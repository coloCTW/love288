/* 发布日常 · 页面专属样式 */

.form-card {
  padding: 36rpx 32rpx;
}

.post-textarea {
  min-height: 200rpx;
}

.filled-photo {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 26rpx;
  background-color: var(--sun-soft);
  background-repeat: no-repeat;
  background-size: 56% 56%;
  background-position: center;
}

.np-btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.np-btn-row .btn {
  flex: 1;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 4rpx;
}

.publish-btn {
  min-height: 100rpx;
  font-size: 31rpx;
  margin-top: 12rpx;
}
