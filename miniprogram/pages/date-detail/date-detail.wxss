/* 约会详情 · 页面专属样式 */

.not-found {
  margin-top: 80rpx;
}

.e-ill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.back-btn {
  margin-top: 28rpx;
}

/* 详情 hero */
.detail-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 24rpx 0 8rpx;
}

.dh-ill {
  width: 168rpx;
  height: 168rpx;
  border-radius: 40rpx;
  background-repeat: no-repeat;
  background-size: 52% 52%;
  background-position: center;
}

.ill-paper-pink { background-color: var(--paper-pink); }
.ill-paper-green { background-color: var(--paper-green); }
.ill-paper-sun { background-color: var(--paper-sun); }
.ill-paper-blue { background-color: var(--paper-blue); }

.dh-title {
  font-family: var(--font-display);
  font-size: 52rpx;
  color: var(--fg);
  margin-top: 20rpx;
}

.dh-countdown {
  font-size: 25rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

.dh-chip {
  margin-top: 16rpx;
}

/* 详情卡 */
.detail-card {
  padding: 16rpx 32rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 0;
}

.detail-row + .detail-row {
  border-top: 2rpx dashed var(--border);
}

.dr-ic {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background-color: var(--accent-soft);
  background-repeat: no-repeat;
  background-size: 48% 48%;
  background-position: center;
  flex-shrink: 0;
}

.dr-main {
  flex: 1;
  min-width: 0;
}

.dr-label {
  font-size: 22rpx;
  color: var(--muted);
}

.dr-value {
  font-size: 28rpx;
  color: var(--fg);
  margin-top: 2rpx;
}

/* 操作行 */
.act-row {
  display: flex;
  gap: 20rpx;
}

.act-row .btn {
  flex: 1;
}

.detail-foot {
  text-align: center;
  font-size: 23rpx;
  color: var(--muted);
}

/* 编辑弹层 */
.ed-form {
  margin-top: 28rpx;
}

.ed-save {
  margin-top: 12rpx;
}
