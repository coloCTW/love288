/* 日常 · 页面专属样式 */
.page-head {
  position: absolute;
  width: 100%;
  top: 0;
  left: 0;
  padding: 0;
  z-index: -1;
}

/* 动态卡片 */
.post-card {
  padding: 28rpx;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.p-who {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
}

.p-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--fg);
}

.p-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-left: 28rpx;
}

.post-head .post-more {
  width: 64rpx;
  height: 64rpx;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  background-position: center;
  opacity: 0.7;
  flex-shrink: 0;
}

.post-body {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--fg);
}

.post-type-tag {
  align-self: flex-start;
  margin-bottom: 12rpx;
}

.body-line {
  display: block;
}

/* 照片宫格 */
.post-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.p-photo {
  width: calc((100% - 28rpx) / 3);
  height: 200rpx;
  border-radius: 24rpx;
  background-color: var(--fg-soft);
  background-repeat: no-repeat;
  background-size: 50% 50%;
  background-position: center;
}

.p-photo.meal {
  background-color: var(--green-soft);
}

.post-photos.one .p-photo {
  width: 100%;
  height: 420rpx;
}

/* 标签 / 互动 */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.post-actions {
  display: flex;
  gap: 28rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed var(--border);
}

.post-act {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 56rpx;
  padding: 0 8rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.act-ic {
  width: 38rpx;
  height: 38rpx;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

.post-act.liked {
  color: var(--pink-ink);
}

.post-act.liked .act-ic {
  animation: heart-pop 0.35s ease-out;
}

/* 评论 */
.post-comments {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
  background: #f6f2e9;
  border-radius: 20rpx;
  border: 2rpx solid #f4e6cd;
}

.cmt {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.c-body {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--fg);
  line-height: 52rpx;
}

.c-name {
  font-weight: 700;
}

/* 评论弹层 */
.cmt-sheet-list {
  margin-top: 24rpx;
  max-height: 400rpx;
  overflow-y: auto;
}

.cmt-empty {
  font-size: 25rpx;
  color: var(--muted);
  text-align: center;
  padding: 12rpx;
}

.cmt-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.cmt-input {
  flex: 1;
  min-height: 80rpx;
}

.cmt-send {
  min-height: 80rpx;
  padding: 0 36rpx;
}

/* FAB */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(140rpx + env(safe-area-inset-bottom));
  bottom: calc(140rpx + constant(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border: 4rpx solid #fb9586;
  border-radius: 999rpx;
  background: #fca595;
  box-shadow: 
    0 0 0 6rpx rgba(255, 255, 255, 0.8),
    0 0 30rpx rgba(238, 154, 131, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

/* 空态插图 */
.e-ill {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
