  <!-- 获取mood主色的标签 -->
  <canvas
  canvas-id="colorCanvas"
  id="colorCanvas"
  type="2d"
  style="position: fixed; left: -9999px; top: -9999px; width: 100px; height: 100px;"
  />
</view>
