<view class="page">
  <view class="page-head">
    <view class="hand">创建一个约会 <text class="heart-txt">❤️</text></view>
    <view class="head-sub">保存后会自动出现在月历上</view>
  </view>

  <view class="card form-card">
    <view class="form-stack">
      <view class="field {{errTitle ? 'invalid' : ''}}">
        <view class="field-label">约会名称<text class="req">*</text></view>
        <input class="input" placeholder-class="ph" placeholder="比如：一起吃火锅、去看海…" value="{{title}}" data-key="title" bindinput="onInput" />
        <view class="f-err">还没有写名称哦，给这个日子起个名字吧～</view>
      </view>
      <view class="field-row">
        <view class="field {{errDate ? 'invalid' : ''}}">
          <view class="field-label">日期<text class="req">*</text></view>
          <picker mode="date" value="{{date}}" start="{{today}}" end="{{maxDate}}" bindchange="onDateChange">
            <view class="picker">{{date}}</view>
          </picker>
          <view class="f-err">还没有选日期哦～</view>
        </view>
        <view class="field">
          <view class="field-label">时间</view>
          <picker mode="time" value="{{time}}" bindchange="onTimeChange">
            <view class="picker">{{time}}</view>
          </picker>
        </view>
      </view>
      <view class="field {{errLoc ? 'invalid' : ''}}">
        <view class="field-label">地点<text class="req">*</text></view>
        <input class="input" placeholder-class="ph" placeholder="比如：海底捞（陆家嘴店）" value="{{location}}" data-key="location" bindinput="onInput" />
        <view class="f-err">地点还没有填哦，先想想去哪里～</view>
      </view>
      <view class="field">
        <view class="field-label">城市</view>
        <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange">
          <view class="picker">
            <text>{{cities[cityIndex]}}</text>
            <view class="picker-arrow"></view>
          </view>
        </picker>
      </view>
      <view class="field">
        <view class="field-label">备注</view>
        <textarea class="textarea note-textarea" placeholder-class="ph" placeholder="想记下什么都可以～" value="{{note}}" data-key="note" bindinput="onInput"></textarea>
      </view>
      <view class="field">
        <view class="field-label">图片（选填）</view>
        <view class="photo-strip">
          <view class="photo-slot {{photoFilled ? 'pink-filled' : ''}}" bindtap="onPhotoTap" hover-class="btn-press">
            <block wx:if="{{photoFilled}}">
              <view class="filled-photo" style="background-image:url('{{photoUri || icons.flower}}');"></view>
              <view class="rm-photo" catchtap="onPhotoRemove" style="background-image:url('{{icons.check}}');"></view>
            </block>
            <block wx:else>
              <view class="ic ic-30" style="background-image:url('{{icons.photo}}');"></view>
              <text>添加图片</text>
            </block>
          </view>
        </view>
      </view>
      <view class="field">
        <view class="field-label">类型</view>
        <view class="type-pick">
          <view
            wx:for="{{types}}"
            wx:key="value"
            class="type-opt {{item.on ? 'on' : ''}}"
            data-value="{{item.value}}"
            bindtap="onTypeTap"
            hover-class="btn-press"
          >
            <view class="ic ic-24" style="background-image:url('{{item.icon}}');"></view>
            <text>{{item.label}}</text>
            <view class="t-dot"></view>
          </view>
        </view>
      </view>
      <button class="btn btn-primary btn-block save-btn" hover-class="btn-press" bindtap="onSubmit">
        <view wx:if="{{busy}}" class="sun-spin ic ic-24" style="background-image:url('{{icons.sun}}');"></view>
        <view wx:else class="ic ic-24" style="background-image:url('{{icons.heart}}');"></view>
        <text>{{busy ? '正在保存' : '保存约会'}}</text>
      </button>
    </view>
  </view>

  <hearts id="hearts"></hearts>
</view>
