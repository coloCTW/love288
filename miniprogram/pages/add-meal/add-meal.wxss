/* 添加约饭 · 页面专属样式 */

.form-card {
  padding: 36rpx 32rpx;
}

.picker-arrow {
  width: 16rpx;
  height: 16rpx;
  border-right: 4rpx solid var(--muted);
  border-bottom: 4rpx solid var(--muted);
  transform: rotate(45deg);
  opacity: 0.6;
}

.filled-photo {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  border-radius: 26rpx;
  background-color: var(--green-soft);
  background-repeat: no-repeat;
  background-size: 56% 56%;
  background-position: center;
}

.submit-btn {
  min-height: 100rpx;
  font-size: 31rpx;
  margin-top: 8rpx;
}
